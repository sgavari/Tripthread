rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.creatorId
        && request.auth.uid in request.resource.data.memberIds;

      // Existing members can update any field. A non-member may "join" by
      // appending exactly their own uid to memberIds and changing nothing
      // else (used by the invite-code join flow).
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberIds
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
        )
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.creatorId;

      // Per-trip nickname, e.g. "Coach" here, something else on another
      // trip. Only trip members can read the roster; each person can only
      // ever write their own nickname doc.
      match /members/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        allow write: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }

      // Group chat. Members can read the full history and post messages
      // (only as themselves); nothing is ever edited or deleted.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false;
      }

      // Shared expenses. Any member can read the full ledger and add an
      // expense (attributed to themselves as creator, though who actually
      // paid can be any member). Only whoever logged it can remove it.
      match /expenses/{expenseId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          && request.auth.uid == request.resource.data.createdByUid
          && request.resource.data.paidByUid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
        allow delete: if request.auth != null
          && request.auth.uid == resource.data.createdByUid;
        allow update: if false;
      }
    }

    // Maps a short invite code -> {tripId}. Lets a non-member look up a
    // trip to join without exposing full trip data or the ability to
    // enumerate codes. Only an existing trip member can mint a code for it.
    match /tripInvites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid in
           get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.memberIds;
      allow update, delete: if false;
    }

    // Public profile info (display name/email/photo) so trip members can
    // resolve each other's uids to something human-readable. Anyone signed
    // in can read any profile; only its owner can write it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // User-generated content reports (App Store Guideline 1.2). Write-only
    // from the client — reports are reviewed out-of-band, not surfaced back
    // to any app user.
    match /messageReports/{reportId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reporterUid;
      allow read, update, delete: if false;
    }
  }
}
